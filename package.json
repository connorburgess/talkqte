{
  "name": "talkqte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:contributions": "node --test scripts/check-contributions.test.mjs",
    "test:cue-lab": "node --test scripts/cue-lab.test.mjs scripts/cue-lab-batch.test.mjs scripts/cue-sim.test.mjs",
    "test:cue-cases": "node --test scripts/cue-rules-independent.test.mjs",
    "test:docs": "node --test scripts/check-docs.test.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test:release": "node --test scripts/release-preflight.test.mjs scripts/third-party-notices.test.mjs scripts/release-build.test.mjs scripts/release-data-snapshot.test.mjs scripts/is-main.test.mjs",
    "build:release": "node scripts/release-build.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "check:notices": "node scripts/third-party-notices.mjs --check",
    "check:release": "node scripts/release-preflight.mjs",
    "lab:claude": "node scripts/cue-lab.mjs",
    "lab:batch": "node scripts/cue-lab-batch.mjs",
    "lab:sim": "node scripts/cue-sim.mjs",
    "lab:record": "node scripts/cue-sim-record.mjs",
    "check": "tsc -b && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check src tests scripts .github/workflows *.json *.ts index.html"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
