{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TalkQTE",
  "version": "0.1.0",
  "identifier": "com.talkqte.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TalkQTE",
        "width": 1320,
        "height": 880,
        "minWidth": 880,
        "minHeight": 640,
        "backgroundColor": "#f7f6f2"
      },
      {
        "label": "cue",
        "title": "TalkQTE companion",
        "url": "index.html?window=cue",
        "width": 320,
        "height": 76,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "backgroundColor": "#203c32"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "Timely questions for better conversations",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
