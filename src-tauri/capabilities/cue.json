{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "cue",
  "description": "The prompt window can read the prompt and dismiss or save it; it cannot export or change notes.",
  "windows": ["cue"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-snapshot",
    "allow-respond-to-cue",
    "allow-set-overlay"
  ]
}
