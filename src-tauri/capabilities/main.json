{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Notebook commands for the local main window only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-snapshot",
    "allow-processing-snapshot",
    "allow-stop-capture",
    "allow-review-processing-scope",
    "allow-approve-processing-scope",
    "allow-cancel-processing-review",
    "allow-revoke-processing",
    "allow-set-processing-paused",
    "allow-set-live-cues-paused",
    "allow-respond-to-cue",
    "allow-inspect-cue",
    "allow-set-companion-position",
    "allow-set-question-size",
    "allow-update-notes",
    "allow-set-sensitivity",
    "allow-set-user-name",
    "allow-set-focus",
    "allow-set-overlay",
    "allow-export-markdown",
    "allow-export-preview",
    "allow-set-keep-meeting",
    "allow-resolve-echo-line",
    "allow-microphone-snapshot",
    "allow-start-microphone",
    "allow-stop-microphone",
    "allow-live-status",
    "allow-provider-keys-status",
    "allow-set-provider-key",
    "allow-test-provider-key",
    "allow-remove-provider-key",
    "allow-cue-usage",
    "allow-transcription-language",
    "allow-set-transcription-language",
    "allow-model-status",
    "allow-pick-context-file",
    "allow-read-context-file-path",
    "allow-import-context-notes",
    "allow-cancel-context-import",
    "allow-context-items",
    "allow-remove-context-item",
    "allow-remove-context-from",
    "allow-connect-granola",
    "allow-cancel-granola-sign-in",
    "allow-granola-status",
    "allow-list-granola-notes",
    "allow-disconnect-granola",
    "allow-suggest-granola-focus",
    "allow-check-granola-updates",
    "allow-stop-granola-update-check",
    "allow-download-model",
    "allow-cancel-model-download",
    "allow-remove-model",
    "allow-start-live-session",
    "allow-stop-live-session",
    "allow-call-prompt-settings",
    "allow-set-call-prompt",
    "allow-clear-call-prompt-apps",
    "allow-respond-to-call-prompt"
  ]
}
