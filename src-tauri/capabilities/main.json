{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Notebook commands for the local main window only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-snapshot",
    "allow-start-demo",
    "allow-pause-demo",
    "allow-resume-demo",
    "allow-end-demo",
    "allow-respond-to-cue",
    "allow-inspect-cue",
    "allow-set-companion-position",
    "allow-set-question-size",
    "allow-update-notes",
    "allow-set-sensitivity",
    "allow-set-user-name",
    "allow-set-focus",
    "allow-set-overlay",
    "allow-export-markdown",
    "allow-export-preview",
    "allow-microphone-snapshot",
    "allow-start-microphone",
    "allow-stop-microphone",
    "allow-live-status",
    "allow-model-status",
    "allow-pick-context-file",
    "allow-import-context-notes",
    "allow-cancel-context-import",
    "allow-context-items",
    "allow-remove-context-item",
    "allow-remove-context-from",
    "allow-connect-granola",
    "allow-cancel-granola-sign-in",
    "allow-granola-status",
    "allow-list-granola-notes",
    "allow-disconnect-granola",
    "allow-suggest-granola-focus",
    "allow-download-model",
    "allow-cancel-model-download",
    "allow-remove-model",
    "allow-start-live-session",
    "allow-stop-live-session"
  ]
}
